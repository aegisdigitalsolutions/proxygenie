# Copy to upstream.env (gitignored) and fill from your proxy / GitHub Actions secrets.
# Never commit real values.

UPSTREAM_HOST=your.proxy.hostname
UPSTREAM_PORT=20027
UPSTREAM_USER=your-username
UPSTREAM_PASS=your-password

# Android gateway LAN IP (hotspot is often 192.168.43.1)
GATEWAY_HOST=192.168.43.1
# MetaClash gateway allow-lan password (user is always "lane")
LAN_PASS=CHANGE_ME_LAN_PASS
